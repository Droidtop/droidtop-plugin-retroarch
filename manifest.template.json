{
  "id": "droidtop.retroarch",
  "origin": "droidtop",
  "label": "RetroArch manager",
  "description": "Gets RetroArch cores for your systems, opens RetroArch, and adds save, load and shader controls for the running game.",
  "summary": "RetroArch cores for your systems, plus save, load and shader controls",
  "publisher": "droidtop",
  "homepage": "https://github.com/Droidtop/droidtop-plugin-retroarch",
  "version": "1.7.0",
  "kind": "native_bundle",
  "contractVersion": 2,
  "category": "emulators",
  "provides": [
    {"point": "ui.panel", "version": 1, "label": "RetroArch", "companion": ["game"], "gamePackages": ["com.retroarch.aarch64", "com.retroarch.ra32", "com.retroarch"]},
    {"point": "ui.quick_tile", "version": 1, "id": "save_state", "label": "Save state", "surfaces": ["gaming.companion", "standard.companion", "desktop.companion"], "needs": "app"},
    {"point": "ui.quick_tile", "version": 1, "id": "fast_forward", "label": "Fast-forward", "surfaces": ["gaming.companion", "standard.companion", "desktop.companion"], "needs": "app"},
    {"point": "ui.status_tile", "version": 1, "id": "state", "label": "RetroArch", "surfaces": ["gaming.quick_menu"], "needs": "app"},
    {"point": "ui.settings", "version": 1, "target": "plugin"},
    {"point": "apps.bridge", "version": 1, "app": "RetroArch", "packages": ["com.retroarch.aarch64", "com.retroarch.ra32", "com.retroarch"], "get": "https://www.retroarch.com/?page=platforms"}
  ],
  "permissions": [
    {"id": "apps.check", "packages": ["com.retroarch.aarch64", "com.retroarch.ra32", "com.retroarch"], "reason": "Finds out which RetroArch you have installed"},
    {"id": "apps.launch", "reason": "Opens RetroArch from its panel"},
    {"id": "retroarch.commands", "reason": "Saves and loads states, changes the slot, fast-forward and shaders in the running game from the companion screen"},
    {"id": "apps.intents.out", "packages": ["com.retroarch.aarch64", "com.retroarch.ra32", "com.retroarch"], "reason": "Starts RetroArch with the core and game you chose"},
    {"id": "net.domains", "domains": ["buildbot.libretro.com"], "reason": "Downloads cores from libretro's build server"},
    {"id": "library.read", "reason": "Lists your systems and which of them RetroArch launches, so its panel shows every system and not only the ones you changed", "required": false},
    {"id": "priv.shell.root", "reason": "Puts a downloaded core into RetroArch's own cores folder, which only root can reach. Optional: without it you install the core from RetroArch itself.", "required": false}
  ],
  "requires": [
    {"api": "priv.shell", "version": "1.0", "optional": true, "minLevel": "root", "reason": "Puts a downloaded core into RetroArch's own cores folder"}
  ],
  "subscribes": [
    {"event": "library.default_player_changed", "version": 2}
  ],
  "subscribedEvents": ["library.default_player_changed"],
  "requestsRoot": false,
  "abis": [],
  "entryClass": "dev.droidtop.plugins.retroarch.RetroArchPlugin"
}
